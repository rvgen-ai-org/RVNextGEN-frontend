BACKEND_URL=
# Development tunnel hostnames only, comma-separated (no scheme or port).
DEV_ORIGINS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Leave empty to use the same-origin API proxy (also works through dev tunnels).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PLAYER_TILT_ENABLED=true
# Live video readback is optional; thumbnail/cinematic ambient work without it.
NEXT_PUBLIC_LIVE_AMBIENT_ENABLED=false
